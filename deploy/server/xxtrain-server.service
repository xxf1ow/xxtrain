[Unit]
Description=xxtrain annotation and training server
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{ROOT}}
Environment=XXTRAIN_SITE_ROOT={{ROOT}}/.deployment
ExecStartPre="{{ROOT}}/.venv/bin/python" -m xxtrain.serverctl prepare
ExecStart="{{ROOT}}/.venv/bin/python" -m xxtrain.serverctl foreground
ExecStopPost=/usr/bin/env docker compose -p xxtrain-server -f {{ROOT}}/deploy/server/compose.yaml stop --timeout 60
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
