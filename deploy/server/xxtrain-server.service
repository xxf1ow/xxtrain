[Unit]
Description=xxtrain server and supporting containers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ROOT}}
User={{USER}}
Environment=XXTRAIN_SITE_ROOT={{ROOT}}/.deployment
TimeoutStartSec=180
ExecStartPre={{ROOT}}/.venv/bin/xxtrain serverctl prepare
ExecStartPre=/usr/bin/docker compose -p xxtrain-server -f {{ROOT}}/deploy/server/compose.yaml up -d --no-build
ExecStartPre={{ROOT}}/.venv/bin/xxtrain serverctl bootstrap --timeout 120
ExecStart={{ROOT}}/.venv/bin/xxtrain serverctl foreground
ExecStopPost=/usr/bin/docker compose -p xxtrain-server -f {{ROOT}}/deploy/server/compose.yaml stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
